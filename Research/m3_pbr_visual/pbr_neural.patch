+{
+	// Loads the minimal DDS files written by Research/m1_differentiable_bc1/bc1.py
+	// (DXT1 FourCC, full mip chain down to 4x4, no partial blocks).
+	std::ifstream file{filename, std::ios::binary | std::ios::ate};
+	if(!file.is_open()) {
+		throw std::runtime_error("Could not open DDS file: " + filename);
+	}
+	const std::streamsize size = file.tellg();
+	std::vector<char> blob(static_cast<size_t>(size));
+	file.seekg(0);
+	file.read(blob.data(), size);
+
+	if(size < 128 || std::memcmp(blob.data(), "DDS ", 4) != 0 || std::memcmp(blob.data() + 84, "DXT1", 4) != 0) {
+		throw std::runtime_error("Not a DXT1 DDS file: " + filename);
+	}
+	const UINT height = *reinterpret_cast<const UINT*>(blob.data() + 12);
+	const UINT width = *reinterpret_cast<const UINT*>(blob.data() + 16);
+	const UINT mipCount = std::max(1u, *reinterpret_cast<const UINT*>(blob.data() + 28));
+
+	Texture texture;
+	texture.width = width;
+	texture.height = height;
+	texture.levels = mipCount;
+
+	D3D12_RESOURCE_DESC desc = {};
+	desc.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+	desc.Width = width;
+	desc.Height = height;
+	desc.DepthOrArraySize = 1;
+	desc.MipLevels = static_cast<UINT16>(mipCount);
+	desc.Format = srgb ? DXGI_FORMAT_BC1_UNORM_SRGB : DXGI_FORMAT_BC1_UNORM;
+	desc.SampleDesc.Count = 1;
+	if(FAILED(m_device->CreateCommittedResource(
+		&CD3DX12_HEAP_PROPERTIES{D3D12_HEAP_TYPE_DEFAULT},
+		D3D12_HEAP_FLAG_NONE, &desc, D3D12_RESOURCE_STATE_COMMON,
+		nullptr, IID_PPV_ARGS(&texture.texture))))
+	{
+		throw std::runtime_error("Failed to create BC1 texture: " + filename);
+	}
+
+	std::vector<D3D12_SUBRESOURCE_DATA> subresources(mipCount);
+	const char* src = blob.data() + 128;
+	for(UINT level = 0; level < mipCount; ++level) {
+		const UINT levelWidth = std::max(4u, width >> level);
+		const UINT levelHeight = std::max(4u, height >> level);
+		const UINT rowPitch = (levelWidth / 4) * 8;
+		subresources[level] = { src, static_cast<LONG_PTR>(rowPitch), static_cast<LONG_PTR>(rowPitch * (levelHeight / 4)) };
+		src += rowPitch * (levelHeight / 4);
+	}
+
+	StagingBuffer staging = createStagingBuffer(texture.texture, 0, mipCount, subresources.data());
+	m_commandList->ResourceBarrier(1, &CD3DX12_RESOURCE_BARRIER::Transition(texture.texture.Get(), D3D12_RESOURCE_STATE_COMMON, D3D12_RESOURCE_STATE_COPY_DEST));
+	for(UINT level = 0; level < mipCount; ++level) {
+		const CD3DX12_TEXTURE_COPY_LOCATION dest{texture.texture.Get(), level};
+		const CD3DX12_TEXTURE_COPY_LOCATION source{staging.buffer.Get(), staging.layouts[level]};
+		m_commandList->CopyTextureRegion(&dest, 0, 0, 0, &source, nullptr);
+	}
+	m_commandList->ResourceBarrier(1, &CD3DX12_RESOURCE_BARRIER::Transition(texture.texture.Get(), D3D12_RESOURCE_STATE_COPY_DEST, D3D12_RESOURCE_STATE_COMMON));
+	executeCommandList();
+	waitForGPU();
+
+	createTextureSRV(texture, D3D12_SRV_DIMENSION_TEXTURE2D);
+	return texture;
+}
+
+void Renderer::loadNeuralMaterial()
+{
+	// Expects data/neural/{latent0..3.dds, weights.bin}; produced by
+	// Research/m3_pbr_visual/export_to_renderer.py. Optional: absence just
+	// leaves the classic texture path active.
+	try {
+		for(int i = 0; i < 4; ++i) {
+			m_latentTextures[i] = createTextureFromBC1DDS("neural/latent" + std::to_string(i) + ".dds");
+		}
+		std::ifstream file{"neural/weights.bin", std::ios::binary | std::ios::ate};
+		if(!file.is_open()) {
+			throw std::runtime_error("Could not open neural/weights.bin");
+		}
+		const std::streamsize size = file.tellg();
+		if(size != 716 * sizeof(float)) {
+			throw std::runtime_error("neural/weights.bin has unexpected size");
+		}
+		std::vector<float> weights(716);
+		file.seekg(0);
+		file.read(reinterpret_cast<char*>(weights.data()), size);
+		m_neuralWeightsCBV = createConstantBufferView(weights.data(), static_cast<UINT>(size));
+
+		m_neuralAvailable = true;
+		std::printf("Neural material loaded (4 BC1 latent mip chains + 12-32-9 MLP). Press N to toggle.\n");
+		std::fflush(stdout);
+	}
+	catch(const std::exception& e) {
+		std::printf("Neural material not loaded (%s); classic textures only.\n", e.what());
+		m_neuralAvailable = false;
+	}
+}
